        "read": "allow",
        "edit": "deny",
        "write": "deny"
      }
    },
    "momus": {
      "permission": {
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "read": "allow",
        "edit": "deny",
        "write": "deny"
      }
    },
    "sisyphus": {
      "permission": {
        "bash": "allow",
