        "glob": "deny",
        "grep": "deny",
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "webfetch": "allow"
      }
    },
    "multimodal-looker": {
      "permission": {
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "read": "allow",
