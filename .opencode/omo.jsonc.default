{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/v4.19.4/assets/omo.schema.json",
  "agents": {
    "plan": {
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k3",
          "variant": "max"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "high"
        },
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "prometheus": {
      "permission": {
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "read": "allow",
        "edit": "deny",
        "write": "deny"
      },
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k3",
          "variant": "max"
        },
        {
          "model": "openai/gpt-5.6-sol",
          "variant": "high"
        },
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "explore": {
      "permission": {
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny"
      }
    },
    "oracle": {
      "permission": {
        "bash": "deny",
        "glob": "deny",
